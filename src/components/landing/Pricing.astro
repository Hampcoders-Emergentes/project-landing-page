---
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { siteConfig } from "../../config";
import { plans } from "../../data/landing";
import { formatSoles, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).pricing;

const regulators = ["SUNAFIL", "INDECI", "OSINERGMIN"];
---

<section id="pricing" aria-labelledby="pricing-title" class="bg-background py-20 lg:py-28">
  <div class="container-page flex flex-col gap-14">
    <SectionHeader id="pricing-title" eyebrow={t.eyebrow} title={t.title} intro={t.intro} align="center" />

    <ul class="grid gap-8 lg:grid-cols-3 lg:gap-6">
      {
        plans.map((plan) => {
          const copy = t.plans[plan.id];
          // Subgrid rows keep price, CTA and feature list aligned across cards.
          return (
            <li
              class:list={[
                "reveal relative flex flex-col gap-6 rounded-2xl bg-surface lg:row-span-4 lg:grid lg:grid-rows-subgrid",
                plan.featured
                  ? "border-2 border-primary p-[1.6875rem] lg:p-[1.9375rem]"
                  : "border border-border p-7 lg:p-8",
              ]}
            >
              {plan.featured && (
                <p class="absolute -top-3.5 left-7 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-surface">
                  {t.recommended}
                </p>
              )}

              <div class="flex flex-col gap-3">
                <h3 class="flex items-center gap-2.5 text-[1.375rem] font-bold">
                  <Icon name={plan.icon} size={24} class="text-primary" />
                  {copy.name}
                </h3>
                <p class="text-[0.9375rem] leading-relaxed text-text-secondary">{copy.description}</p>
              </div>

              {typeof plan.price === "number" ? (
                <p class="flex flex-wrap items-baseline gap-x-1.5">
                  <span class="tnum text-4xl font-bold">{formatSoles(lang, plan.price)}</span>
                  <span class="text-text-secondary">{t[plan.unit]}</span>
                </p>
              ) : plan.price === "custom" ? (
                <p class="flex flex-wrap items-baseline gap-x-1.5">
                  <span class="text-4xl font-bold">{t.custom}</span>
                  <span class="text-text-secondary">{t.annual}</span>
                </p>
              ) : (
                <div class="flex gap-3 rounded-lg border border-dashed border-text-secondary bg-subtle p-3.5">
                  <Icon name="info-circle" class="mt-0.5" />
                  <div class="text-sm leading-relaxed">
                    <p class="font-semibold">{t.unavailable.title}</p>
                    <p class="text-text-secondary">
                      {t.unavailable.body}{" "}
                      <a href="#contact" class="font-semibold text-primary underline underline-offset-2">
                        {t.unavailable.cta}
                      </a>
                    </p>
                  </div>
                </div>
              )}

              <a href="#contact" class:list={["btn", plan.featured ? "btn-primary" : "btn-outline"]}>
                {copy.cta}
              </a>

              <div class="border-t border-border pt-6">
                <p class="eyebrow text-text-secondary">{t.featuresLabel}</p>
                <ul class="mt-4 flex flex-col gap-3 text-[0.9375rem]">
                  {copy.features.map((feature) => (
                    <li class="flex gap-2.5">
                      <Icon name="check" class="mt-0.5 text-primary" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })
      }
    </ul>

    <!-- Compliance dossier highlight (US06) -->
    <div
      class="reveal grid gap-8 rounded-2xl bg-background-dark p-7 text-surface sm:p-10 lg:grid-cols-[auto_minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-10"
    >
      <span
        class="flex size-16 items-center justify-center rounded-2xl border border-border-dark bg-dark-raised text-on-dark"
      >
        <Icon name="file-check" size={32} />
      </span>
      <div class="flex flex-col gap-3">
        <h3 class="text-2xl font-bold">{t.dossier.title}</h3>
        <p class="leading-relaxed text-on-dark-muted">{t.dossier.body}</p>
        <ul class="flex flex-wrap gap-2 pt-1">
          {
            regulators.map((name) => (
              <li class="rounded-md border border-border-dark px-2.5 py-1 text-xs font-semibold tracking-wide text-on-dark">
                {name}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-3">
        <p class="eyebrow text-on-dark-muted">{t.dossier.filesLabel}</p>
        <ul class="flex flex-col gap-2">
          {
            t.dossier.files.map((file) => (
              <li>
                <a
                  href={file.href}
                  download
                  type="application/pdf"
                  class="group flex min-h-13 items-center gap-3 rounded-lg border border-border-dark bg-dark-raised py-2 pr-2 pl-3.5 text-sm font-medium text-surface transition-colors hover:border-on-dark-muted"
                >
                  <Icon name="file" class="text-on-dark" />
                  <span class="min-w-0 flex-1">
                    <span class="sr-only">{t.dossier.download}: </span>
                    {file.title}
                  </span>
                  <span class="text-xs font-semibold text-on-dark-muted">{file.format}</span>
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-md border border-border-dark text-on-dark transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-surface">
                    <Icon name="download" size={18} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="flex items-center gap-2 text-xs text-on-dark-muted">
          <Icon name="info-circle" size={14} />
          {t.dossier.sampleNote}
        </p>
        <a href="#contact" class="btn btn-primary mt-1">
          <Icon name="file-check" />
          {t.dossier.cta}
        </a>
      </div>
    </div>

    <p class="flex flex-wrap items-center justify-center gap-x-3 text-center text-text-secondary">
      {t.customer.text}
      <a
        href={siteConfig.webAppUrl}
        data-webapp-link
        class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-primary underline-offset-4 hover:underline"
      >
        <Icon name="login-2" size={18} />
        {t.customer.cta}
      </a>
    </p>
  </div>
</section>
