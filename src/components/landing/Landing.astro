---
import Layout from "../../layouts/Layout.astro";
import Contact from "./Contact.astro";
import Ecosystem from "./Ecosystem.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Management from "./Management.astro";
import Pricing from "./Pricing.astro";
import Problems from "./Problems.astro";
import Safety from "./Safety.astro";
import SystemNotices from "./SystemNotices.astro";
import type { Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Header lang={lang} />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <Hero lang={lang} />
    <Problems lang={lang} />
    <Safety lang={lang} />
    <Management lang={lang} />
    <Ecosystem lang={lang} />
    <Pricing lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <SystemNotices lang={lang} />
</Layout>
