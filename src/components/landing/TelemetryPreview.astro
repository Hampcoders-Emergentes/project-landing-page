---
import Icon from "../ui/Icon.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import { heroTelemetry } from "../../data/landing";
import { formatNumber, getIntlLocale, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang).hero.preview;

const { voltageTrend, voltageRange, equipment, leakageMa } = heroTelemetry;
const [vMin, vMax] = voltageRange;
const CHART_W = 240;
const CHART_H = 56;
const toY = (volts: number) => CHART_H - 4 - ((volts - vMin) / (vMax - vMin)) * (CHART_H - 8);
const points = voltageTrend
  .map((volts, i) => `${((i / (voltageTrend.length - 1)) * CHART_W).toFixed(1)},${toY(volts).toFixed(1)}`)
  .join(" ");
const currentVoltage = voltageTrend[voltageTrend.length - 1];
---

<figure
  aria-labelledby="telemetry-caption"
  class:list={["m-0 w-full", className]}
  data-telemetry
  data-locale={getIntlLocale(lang)}
  data-trend={JSON.stringify(voltageTrend)}
  data-range={voltageRange.join(",")}
>
  <div
    class="rounded-2xl border border-border-dark bg-dark-raised p-2.5 shadow-[0_32px_64px_-24px_rgb(0_0_0/0.55)] sm:p-3.5"
  >
    <div class="overflow-hidden rounded-xl bg-surface text-text-primary">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3 sm:px-5">
        <p class="flex items-center gap-2.5 text-sm font-semibold">
          <Icon name="device-mobile" class="text-primary" />
          {t.panel}
        </p>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-2.5 py-1 text-xs font-semibold text-text-secondary"
        >
          <span class="relative flex size-2.5" aria-hidden="true">
            <span class="absolute inline-flex size-full rounded-full bg-accent opacity-75 motion-safe:animate-ping"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-accent"></span>
          </span>
          <span class="tracking-wide uppercase">{t.live}</span>
          <span aria-hidden="true">·</span>
          <span class="tnum">{t.sensors}</span>
        </p>
      </div>

      <div class="grid gap-3 bg-background p-3 sm:grid-cols-2 sm:p-4">
        <div class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-4">
          <p class="text-xs font-semibold tracking-wider text-text-secondary uppercase">{t.leakage}</p>
          <p class="flex items-baseline gap-1.5 text-success">
            <span class="tnum text-5xl leading-none font-bold">{formatNumber(lang, leakageMa)}</span>
            <span class="text-xl font-semibold">mA</span>
          </p>
          <StatusBadge status="success" label={t.safeCircuit} class="self-start" />
          <p class="text-xs text-text-secondary">{t.tripThreshold}</p>
        </div>

        <div class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-4">
          <p class="text-xs font-semibold tracking-wider text-text-secondary uppercase">{t.voltage}</p>
          <p class="flex items-baseline gap-1.5">
            <span class="tnum text-5xl leading-none font-bold" data-voltage>
              {formatNumber(lang, currentVoltage, 1)}
            </span>
            <span class="text-xl font-semibold">V</span>
          </p>
          <StatusBadge status="success" label={t.stable} class="self-start" />
          <p class="text-xs text-text-secondary">{t.nominal}</p>
        </div>

        <div class="rounded-xl border border-border bg-surface px-4 pt-3 pb-2 sm:col-span-2">
          <p class="text-xs font-semibold tracking-wider text-text-secondary uppercase">{t.trend}</p>
          <svg
            viewBox={`0 0 ${CHART_W} ${CHART_H}`}
            preserveAspectRatio="none"
            class="mt-1 h-14 w-full"
            aria-hidden="true"
          >
            <line
              x1="0"
              x2={CHART_W}
              y1={toY(220)}
              y2={toY(220)}
              stroke="var(--color-border)"
              stroke-dasharray="4 4"
              vector-effect="non-scaling-stroke"></line>
            <polyline
              points={points}
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="2"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
              data-sparkline></polyline>
          </svg>
        </div>
      </div>

      <div class="border-t border-border px-4 py-3 sm:px-5">
        <p class="text-xs font-semibold tracking-wider text-text-secondary uppercase">{t.equipment}</p>
        <ul class="mt-1 divide-y divide-subtle">
          {
            equipment.map((item) => (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2.5">
                <span class="min-w-0 flex-1 text-sm font-semibold">{t.items[item.id]}</span>
                <span class="tnum text-sm text-text-secondary">
                  {formatNumber(lang, item.value, 1)} {item.unit}
                </span>
                <StatusBadge size="sm" status={item.status} label={item.status === "success" ? t.ok : t.warning} />
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="flex items-center gap-2 border-t border-border bg-background px-4 py-3 text-xs font-semibold text-text-secondary sm:px-5"
        aria-hidden="true"
      >
        <span>{t.path.panel}</span>
        <span class="relative h-0.5 flex-1 rounded-full bg-accent/25">
          <span class="absolute top-1/2 left-0 size-2 -translate-1/2 rounded-full bg-accent motion-safe:animate-signal"
          ></span>
        </span>
        <span>{t.path.gateway}</span>
        <span class="relative h-0.5 flex-1 rounded-full bg-accent/25">
          <span
            class="absolute top-1/2 left-0 size-2 -translate-1/2 rounded-full bg-accent motion-safe:animate-signal motion-safe:animation-delay-[1.2s]"
          ></span>
        </span>
        <span>{t.path.cloud}</span>
      </div>
    </div>
  </div>
  <figcaption id="telemetry-caption" class="mt-3 flex items-center gap-2 text-sm text-on-dark-muted">
    <Icon name="info-circle" size={16} />
    <span>{t.simulated}<span class="sr-only">: {t.caption}</span></span>
  </figcaption>
</figure>

<script>
  // Simulated live voltage. Pauses off-screen, in background tabs, with reduced
  // motion and on limited connections.
  const root = document.querySelector<HTMLElement>("[data-telemetry]");
  const valueEl = root?.querySelector<HTMLElement>("[data-voltage]");
  const line = root?.querySelector<SVGPolylineElement>("[data-sparkline]");

  if (root && valueEl && line) {
    const values: number[] = JSON.parse(root.dataset.trend ?? "[]");
    const [min, max] = (root.dataset.range ?? "218,222").split(",").map(Number);
    const format = new Intl.NumberFormat(root.dataset.locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const width = 240;
    const height = 56;
    let inView = false;
    let timer: number | undefined;

    const toY = (volts: number) => height - 4 - ((volts - min) / (max - min)) * (height - 8);

    const tick = () => {
      const last = values[values.length - 1] ?? 220;
      const drift = (Math.random() - 0.5) * 0.6 + (220 - last) * 0.2;
      const next = Math.round(Math.min(221.2, Math.max(218.8, last + drift)) * 10) / 10;
      values.push(next);
      values.shift();
      valueEl.textContent = format.format(next);
      line.setAttribute(
        "points",
        values.map((v, i) => `${((i / (values.length - 1)) * width).toFixed(1)},${toY(v).toFixed(1)}`).join(" "),
      );
    };

    const sync = () => {
      const run =
        inView &&
        !document.hidden &&
        !reducedMotion.matches &&
        document.documentElement.dataset.connection !== "limited";
      if (run && timer === undefined) timer = window.setInterval(tick, 2000);
      if (!run && timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }).observe(root);
    document.addEventListener("visibilitychange", sync);
    reducedMotion.addEventListener("change", sync);
    document.addEventListener("electrolink:connectivity", sync);
  }
</script>
